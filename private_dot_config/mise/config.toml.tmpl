# mise here is scoped to settings only — the global [tools] list is empty.
# General CLI tools live in brewfile.txt (macOS) via Homebrew instead; mise
# itself stays installed (see brewfile.txt: `brew "mise"`) so per-project
# mise.toml files (e.g. spouterinn, edc) can still pin their own tool
# versions when you cd into them.

[settings.age]
# Identity used to decrypt native age-encrypted `[env]` values in project
# `mise.toml` files (e.g. spouterinn's `GORELEASER_KEY`, `COSIGN_PRIVATE_KEY`).
# Without this, mise fails with "No age identities found for decryption".
# CI overrides it with the `MISE_AGE_KEY` env var instead.
key_file = "~/.config/age/key.txt"
